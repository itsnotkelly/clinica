{
  "name": "Patient",
  "type": "object",
  "properties": {
    "patient_code": {
      "type": "string",
      "description": "ID interno del paciente"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "sex": {
      "type": "string",
      "enum": [
        "",
        "femenino",
        "masculino",
        "otro"
      ]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    },
    "consent_data": {
      "type": "boolean",
      "default": false
    },
    "consent_date": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "recepcion"
          }
        },
        {
          "user_condition": {
            "role": "dentista"
          }
        },
        {
          "user_condition": {
            "role": "asistente"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "recepcion"
          }
        },
        {
          "user_condition": {
            "role": "dentista"
          }
        },
        {
          "user_condition": {
            "role": "asistente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "recepcion"
          }
        },
        {
          "user_condition": {
            "role": "dentista"
          }
        },
        {
          "user_condition": {
            "role": "asistente"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}